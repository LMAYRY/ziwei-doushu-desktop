# 复制为 .env.local 后填入实际值

# ─── 单盘 AI 解读（DeepSeek）───
# 排盘、命盘展示不需要 API Key；AI 解读（/api/interpret、/api/heming）在配置后可用。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash

# 硅基流动（将 AI_PROVIDER 改为 siliconflow 后生效）
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# ─── 其他 OpenAI 兼容模型尚未接入 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 本机自用 ───
# 在自己电脑上运行时打开书库管理和导入书（导入的书写在项目目录的 library/ 下）。
# 公开部署给别人用的网站不要打开。
ZIWEI_SELF_HOSTED=1

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
